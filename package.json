{
  "name": "@zabaca/claude-code-agent-sdk-ui",
  "version": "0.0.0",
  "description": "A fully-wired Claude Code UI for the Claude Agent SDK — Brainless components with a real runtime behind them.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zabaca/claude-code-agent-sdk-ui.git"
  },
  "homepage": "https://github.com/Zabaca/claude-code-agent-sdk-ui",
  "packageManager": "bun@1.3.14",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    "./core": { "types": "./dist/core/index.d.ts", "default": "./dist/core/index.js" },
    "./server": { "types": "./dist/server/index.d.ts", "default": "./dist/server/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "default": "./dist/react/index.js" },
    "./ui": { "types": "./dist/ui/index.d.ts", "default": "./dist/ui/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "build": "bun run build:js && bun run build:css",
    "build:js": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:css": "tailwindcss --input ./src/ui/tailwind.css --output ./dist/styles.css",
    "canary": "LIVE_CANARY=1 bun test test/live.canary.test.ts",
    "prepack": "bun run build",
    "dev": "bun run --hot example/server.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.220",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": false
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@happy-dom/global-registrator": "^20.11.2",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
